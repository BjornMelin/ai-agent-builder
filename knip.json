{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["tailwindcss", "tw-animate-css"],
  "ignoreFiles": ["tests/mocks/empty.ts"],
  "ignoreIssues": {
    "src/app/.well-known/workflow/**": ["unlisted"]
  },
  "include": ["files", "dependencies", "unlisted"],
  "next": true,
  "project": [
    "src/**/*.{ts,tsx,js,jsx}",
    "tests/**/*.{ts,tsx,js,jsx}",
    "scripts/**/*.{ts,tsx,js,jsx}",
    "*.{js,ts,mjs,cjs,cts,mts}"
  ],
  "rules": {
    "exports": "off",
    "types": "off"
  },
  "vitest": true
}

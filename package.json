{
  "name": "ai-agent-builder",
  "version": "0.1.14",
  "private": true,
  "engines": {
    "bun": ">=1.2.0",
    "node": "24.x"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "auth:audit:local": "bun scripts/neon-auth-local.ts audit",
    "auth:create:local": "bun scripts/neon-auth-local.ts create",
    "auth:repair:local": "bun scripts/neon-auth-local.ts repair",
    "auth:smoke:local": "bun scripts/neon-auth-local.ts smoke",
    "build": "bun --bun next build",
    "build:vercel": "bun run db:migrate && bun run build",
    "ci": "bun run lint && bun run knip && bun run typecheck && bun run test:coverage && bun run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "bun --bun next dev",
    "fetch:models": "bash scripts/fetch-models.sh",
    "format": "biome check --write .",
    "lint": "bun run lint:biome && bun run lint:eslint",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "knip": "knip --no-progress --no-config-hints",
    "start": "bun --bun next start",
    "test": "bun run typegen && vitest run",
    "test:coverage": "bun run typegen && vitest run --coverage",
    "test:ci:merge": "mkdir -p .vitest-reports && vitest --merge-reports .vitest-reports/blob --reporter=github-actions --reporter=junit --outputFile.junit=.vitest-reports/junit.xml",
    "test:ci:shard": "bun run typegen && mkdir -p .vitest-reports/blob && vitest run --shard=$VITEST_SHARD_INDEX/$VITEST_SHARD_COUNT --reporter=blob --outputFile.blob=.vitest-reports/blob/$VITEST_SHARD_INDEX.json",
    "test:a11y": "vitest run src/components/ai-elements/tests/accessibility.test.tsx src/components/ai-elements/tests/code-block.test.tsx src/components/ui/tests/command.test.tsx src/components/ui/confirm-dialog.test.tsx 'src/app/(app)/projects/[projectId]/settings/project-lifecycle-settings.test.tsx'",
    "test:a11y:watch": "vitest src/components/ai-elements/tests/accessibility.test.tsx src/components/ai-elements/tests/code-block.test.tsx src/components/ui/tests/command.test.tsx src/components/ui/confirm-dialog.test.tsx 'src/app/(app)/projects/[projectId]/settings/project-lifecycle-settings.test.tsx'",
    "test:watch": "vitest",
    "typecheck": "bun run typegen && tsc -p tsconfig.json --noEmit",
    "typegen": "bun -e \"import { rmSync } from 'node:fs'; rmSync('.next/types', { recursive: true, force: true }); rmSync('.next/dev/types', { recursive: true, force: true });\" && bun --bun next typegen"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.41",
    "@ai-sdk/provider": "4.0.9",
    "@ai-sdk/provider-utils": "5.0.34",
    "@ai-sdk/react": "4.0.90",
    "@ai-sdk/workflow": "1.0.22",
    "@mendable/firecrawl-js": "^4.38.0",
    "@neondatabase/auth": "0.2.0-beta.1",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@upstash/qstash": "2.11.3",
    "@upstash/ratelimit": "~2.0.8",
    "@upstash/redis": "1.38.3",
    "@upstash/vector": "~1.2.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "^3.9.5",
    "@vercel/sandbox": "^1.10.2",
    "@vercel/sdk": "^1.28.25",
    "@workflow/errors": "4.2.1",
    "ai": "7.0.87",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "client-only": "0.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "~0.45.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "1.38.0",
    "media-chrome": "^4.19.2",
    "motion": "12.42.2",
    "nanoid": "6.0.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shiki": "4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "workflow": "4.8.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@eslint/js": "9.39.5",
    "@next/env": "16.3.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/parser": "8.69.0",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-jsdoc": "63.0.13",
    "eslint-plugin-tsdoc": "0.5.2",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "knip": "6.34.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.11"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
